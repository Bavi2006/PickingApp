@{
    ViewData["Title"] = "Cargar Archivo Excel de Pedidos";
    var errores = ViewBag.Errores as List<string>;
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-file-earmark-excel-fill text-success me-2"></i> Cargar Archivo Excel de Pedidos (CU-23)
                    </h5>
                    <a asp-action="DescargarPlantilla" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-download me-1"></i> Descargar Plantilla .xlsx
                    </a>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small">
                        Selecciona el archivo Excel (.xlsx) elaborado por el área de planeación. El sistema analizará su estructura, validará las bodegas y ubicaciones, y registrará los pedidos.
                    </p>

                    @if (errores != null && errores.Any())
                    {
                        <div class="alert alert-danger mb-4">
                            <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i> Observaciones de validación encontradas:</h6>
                            <ul class="mb-0 ps-3 small">
                                @foreach (var err in errores)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="CargarExcel" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Archivo de Pedidos (.xlsx)</label>
                            <input type="file" name="archivoExcel" class="form-control form-control-lg" accept=".xlsx" required />
                            <div class="form-text small">Estructura esperada: CodigoPedido, Bodega, Pasillo, Estante, Nivel, CodigoProducto, NombreProducto, Cantidad, Prioridad.</div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Cargar y Procesar Pedidos
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
