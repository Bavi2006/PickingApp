@{
    ViewData["Title"] = "Cargar archivo Excel";
    var errores = ViewBag.Errores as List<string>;
}

<h1 class="pf-page-title">Cargar archivo Excel</h1>

<div class="mockup-card">
    <form asp-action="CargarExcel" method="post" enctype="multipart/form-data" id="formExcel">
        @Html.AntiForgeryToken()

        <div class="mockup-upload-box mb-4">
            <h3 class="fw-bold text-dark mb-2">Seleccionar archivo Excel</h3>
            <p class="text-secondary mb-4">Cargue el archivo previamente creado con los pedidos.</p>

            <div class="d-flex justify-content-center align-items-center mb-4">
                <input type="file" name="archivoExcel" id="archivoExcel" class="form-control" accept=".xlsx" style="max-width: 420px;" required onchange="onFileSelected(this)" />
            </div>

            <button type="button" class="btn-pf-blue px-4 py-2" id="btnValidar" onclick="validarArchivoLocal()">
                Validar archivo
            </button>
        </div>

        @if (errores != null && errores.Any())
        {
            <div class="mockup-alert-warning mb-4">
                <strong>Observaciones de validación encontradas:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var err in errores)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <!-- Resultado de validación (Slide 11) -->
        <div id="sectionValidacion" style="display: none;" class="mt-4 pt-3 border-top">
            <h4 class="fw-bold text-dark mb-3">Resultado de validación</h4>
            <div class="d-flex flex-column gap-2 mb-4">
                <div class="d-flex align-items-center text-dark">
                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i> Estructura de archivo valida
                </div>
                <div class="d-flex align-items-center text-dark">
                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i> Tipo de archivo valido
                </div>
                <div class="d-flex align-items-center text-dark">
                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i> Bodega registrada
                </div>
                <div class="d-flex align-items-center text-dark">
                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i> Ubicaciones registradas
                </div>
            </div>

            <button type="submit" class="btn-pf-blue px-4 py-2">
                Confirmar carga de pedido
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function onFileSelected(input) {
            if (input.files && input.files.length > 0) {
                // When file is picked, ready for validation
            }
        }

        function validarArchivoLocal() {
            const input = document.getElementById('archivoExcel');
            if (!input.files || input.files.length === 0) {
                alert('Por favor selecciona un archivo Excel (.xlsx) primero.');
                return;
            }
            const fileName = input.files[0].name;
            if (!fileName.endsWith('.xlsx')) {
                alert('El archivo debe tener extensión .xlsx');
                return;
            }
            // Show validation result section matching Slide 11
            document.getElementById('sectionValidacion').style.display = 'block';
            document.getElementById('btnValidar').style.display = 'none';
        }
    </script>
}
