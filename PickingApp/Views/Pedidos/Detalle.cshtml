@model PickingApp.Models.Pedido
@{
    ViewData["Title"] = $"Detalle Pedido {Model.CodigoPedido}";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
    var empleados = ViewBag.EmpleadosDisponibles as IEnumerable<PickingApp.Models.Empleado>;
    var badgePrioridad = Model.Prioridad == "Alta" ? "bg-danger" : (Model.Prioridad == "Media" ? "bg-warning text-dark" : "bg-secondary");
    var badgeEstado = Model.Estado switch
    {
        "Pendiente" => "bg-secondary",
        "Asignado" => "bg-info text-dark",
        "EnProceso" => "bg-primary",
        "Completado" => "bg-success",
        "Cancelado" => "bg-danger",
        "Reasignado" => "bg-warning text-dark",
        _ => "bg-light text-dark"
    };
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Pedidos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.CodigoPedido</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold mb-0">@Model.CodigoPedido</h2>
                <span class="badge @badgePrioridad fs-6">Prioridad: @Model.Prioridad</span>
                <span class="badge @badgeEstado fs-6 rounded-pill">@Model.Estado</span>
            </div>
            <p class="text-muted mt-1 mb-0">Bodega: <strong>@(Model.Bodega?.Nombre) (@(Model.Bodega?.Codigo))</strong> &bull; Fecha Carga: @Model.FechaCarga.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (userRole == "Administrador" || userRole == "Supervisor")
            {
                @if (Model.Estado == "Pendiente")
                {
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAsignar">
                        <i class="bi bi-person-check-fill me-1"></i> Asignar a Empleado
                    </button>
                }
                else if (Model.Estado == "Asignado" || Model.Estado == "EnProceso" || Model.Estado == "Reasignado")
                {
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCompletar">
                        <i class="bi bi-check2-circle me-1"></i> Marcar Completado
                    </button>
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalReasignar">
                        <i class="bi bi-arrow-repeat me-1"></i> Reasignar
                    </button>
                }

                @if (Model.Estado != "Completado" && Model.Estado != "Cancelado")
                {
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalCancelar">
                        <i class="bi bi-x-circle me-1"></i> Cancelar Pedido
                    </button>
                }

                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalNovedad">
                    <i class="bi bi-flag-fill me-1 text-warning"></i> Novedad
                </button>
            }

            @if (userRole == "Administrador" && Model.Estado != "Cancelado")
            {
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalPrioridad">
                    <i class="bi bi-sliders2 me-1"></i> Cambiar Prioridad
                </button>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="text-muted small fw-semibold text-uppercase mb-1">Empleado Asignado</div>
            @if (Model.Empleado != null)
            {
                <h5 class="fw-bold text-primary mb-1">@Model.Empleado.NombreCompleto</h5>
                <div class="small text-muted">ID: @Model.Empleado.Identificacion &bull; Turno: @Model.Empleado.JornadaLaboral</div>
                <div class="small mt-1">
                    Experiencia: <strong>@Model.Empleado.MesesExperiencia meses</strong>
                    @if (Model.Empleado.TieneMenosDeSeisMeses)
                    {
                        <span class="badge bg-warning text-dark">&lt; 6 meses</span>
                    }
                </div>
            }
            else
            {
                <h5 class="text-muted mb-0">Pendiente de asignación</h5>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="text-muted small fw-semibold text-uppercase mb-1">Tiempos de Picking</div>
            <div>Estimado: <strong>@(Model.TiempoEstimadoMinutos?.ToString("0.0") ?? "-") min</strong></div>
            <div>Asignado el: @(Model.FechaAsignacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
            <div>Margen de inicio (+2 min): @(Model.FechaInicioProceso?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
            <div>Finalizado el: @(Model.FechaFinalizacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
            <div class="mt-1">
                Tiempo real efectivo: 
                <span class="badge bg-light text-dark border fs-6">
                    @(Model.TiempoProcesamientoMinutos?.ToString("0.0") ?? "-") min
                </span>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="text-muted small fw-semibold text-uppercase mb-1">Motivos y Observaciones</div>
            @if (!string.IsNullOrEmpty(Model.MotivoCancelacion))
            {
                <div class="alert alert-danger py-1 px-2 small mb-1">
                    <strong>Cancelado:</strong> @Model.MotivoCancelacion
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.MotivoReasignacion))
            {
                <div class="alert alert-warning py-1 px-2 small mb-1">
                    <strong>Reasignado:</strong> @Model.MotivoReasignacion
                </div>
            }
            <div>Novedades registradas: <strong>@Model.Novedades.Count</strong></div>
            <div>Entrega física confirmada: <strong>@(Model.ConfirmacionFisica ? "Sí" : "No")</strong></div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-map-fill text-primary me-2"></i> Ruta de Picking (@Model.Detalles.Count productos)
        </h5>
        <span class="badge bg-light text-muted border">Total: @Model.Detalles.Sum(d => d.Cantidad) unidades</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Código Producto</th>
                    <th>Descripción del Producto</th>
                    <th class="text-center">Cantidad</th>
                    <th>Ubicación Física</th>
                    <th>Pasillo</th>
                    <th>Estante</th>
                    <th>Nivel</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles.OrderBy(x => x.Ubicacion?.Pasillo).ThenBy(x => x.Ubicacion?.Estante).ThenBy(x => x.Ubicacion?.Nivel))
                {
                    <tr>
                        <td class="ps-4 fw-semibold text-dark">@d.CodigoProducto</td>
                        <td>@d.NombreProducto</td>
                        <td class="text-center">
                            <span class="badge bg-primary fs-6 px-3 py-1">@d.Cantidad</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-primary border fw-semibold">
                                <i class="bi bi-geo-alt me-1"></i> @(d.Ubicacion?.CodigoUbicacion ?? "N/A")
                            </span>
                        </td>
                        <td>@(d.Ubicacion?.Pasillo ?? "-")</td>
                        <td>@(d.Ubicacion?.Estante ?? "-")</td>
                        <td>@(d.Ubicacion?.Nivel ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-exclamation-octagon-fill text-warning me-2"></i> Novedades del Pedido (@Model.Novedades.Count)
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Novedades.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Fecha</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Registrado Por</th>
                            <th>Estado</th>
                            <th>Observaciones Atención</th>
                            @if (userRole == "Administrador")
                            {
                                <th class="text-end pe-4">Acción</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var nov in Model.Novedades.OrderByDescending(n => n.FechaRegistro))
                        {
                            <tr>
                                <td class="ps-4 small text-muted">@nov.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-warning text-dark">@nov.TipoNovedad</span></td>
                                <td>@nov.Descripcion</td>
                                <td class="small">@nov.RegistradoPor</td>
                                <td>
                                    <span class="badge @(nov.Atendida ? "bg-success" : "bg-danger") rounded-pill">
                                        @(nov.Atendida ? "Atendida" : "Pendiente")
                                    </span>
                                </td>
                                <td class="small text-muted">@(nov.ObservacionesAtencion ?? "Sin observaciones")</td>
                                @if (userRole == "Administrador")
                                {
                                    <td class="text-end pe-4">
                                        @if (!nov.Atendida)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalAtenderNov_@nov.Id">
                                                <i class="bi bi-check2"></i> Marcar Atendida
                                            </button>

                                            <div class="modal fade text-start" id="modalAtenderNov_@nov.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form asp-action="AtenderNovedad" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="novedadId" value="@nov.Id" />
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold text-primary">Atender Novedad #@nov.Id</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold">Observaciones de Atención:</label>
                                                                    <textarea name="observacionesAtencion" class="form-control" rows="3" placeholder="Detalle cómo se atendió la novedad"></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                                <button type="submit" class="btn btn-primary">Confirmar Atención</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted small">
                No hay novedades registradas para este pedido.
            </div>
        }
    </div>
</div>

<!-- Modal Asignar (CU-26) -->
<div class="modal fade" id="modalAsignar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Asignar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary"><i class="bi bi-person-check-fill me-2"></i>Asignar Pedido a Empleado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccionar Empleado Disponible:</label>
                        <select name="empleadoId" class="form-select" required>
                            <option value="">-- Seleccione un empleado --</option>
                            @if (empleados != null)
                            {
                                @foreach (var emp in empleados)
                                {
                                    <option value="@emp.Id">
                                        @emp.NombreCompleto - @emp.JornadaLaboral (@emp.MesesExperiencia meses exp.) [@emp.EstadoDisponibilidad]
                                    </option>
                                }
                            }
                        </select>
                        <div class="form-text small">
                            El sistema verificará automáticamente el turno, disponibilidad y tiempo restante.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Confirmar Asignación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Reasignar (CU-27) -->
<div class="modal fade" id="modalReasignar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reasignar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-warning"><i class="bi bi-arrow-repeat me-2"></i>Reasignar Pedido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nuevo Empleado Asignado:</label>
                        <select name="nuevoEmpleadoId" class="form-select" required>
                            <option value="">-- Seleccione nuevo empleado --</option>
                            @if (empleados != null)
                            {
                                @foreach (var emp in empleados.Where(e => e.Id != Model.EmpleadoId))
                                {
                                    <option value="@emp.Id">@emp.NombreCompleto - @emp.JornadaLaboral</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Motivo de Reasignación (Obligatorio):</label>
                        <textarea name="motivoReasignacion" class="form-control" rows="3" required placeholder="Indique la causa del cambio"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Confirmar Reasignación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Completar (CU-28) -->
<div class="modal fade" id="modalCompletar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="MarcarCompletado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-2"></i>Finalizar Pedido de Picking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>¿Desea marcar como completado el pedido <strong>@Model.CodigoPedido</strong>?</p>
                    <div class="form-check p-3 bg-light rounded-3 mb-2">
                        <input class="form-check-input" type="checkbox" name="confirmacionFisica" id="chkFisica" value="true" required />
                        <label class="form-check-label fw-semibold text-dark" for="chkFisica">
                            Confirmo que el empleado ha entregado físicamente la mercancía completa (RN-01-CU28).
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Marcar como Completado</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Cancelar (CU-31) -->
<div class="modal fade" id="modalCancelar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancelar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle me-2"></i>Cancelar Pedido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning small">
                        <strong>Atención:</strong> Un pedido cancelado no podrá volver a reactivarse (RNF-01).
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Motivo de Cancelación (Obligatorio):</label>
                        <textarea name="motivoCancelacion" class="form-control" rows="3" required placeholder="Especifique el motivo de cancelación"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-danger">Confirmar Cancelación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Registrar Novedad (CU-29) -->
<div class="modal fade" id="modalNovedad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RegistrarNovedad" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-warning"><i class="bi bi-flag-fill me-2"></i>Registrar Novedad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de Novedad:</label>
                        <select name="tipoNovedad" class="form-select">
                            <option value="Faltante">Faltante de Producto</option>
                            <option value="Avería">Avería / Producto Dañado</option>
                            <option value="Ubicación Incorrecta">Ubicación Física Incorrecta</option>
                            <option value="Diferencia Cantidad">Diferencia de Cantidades</option>
                            <option value="Otro">Otro Motivo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción de la Novedad:</label>
                        <textarea name="descripcion" class="form-control" rows="3" required placeholder="Detalle la situación encontrada"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Registrar Novedad</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Cambiar Prioridad (CU-25) -->
<div class="modal fade" id="modalPrioridad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CambiarPrioridad" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary"><i class="bi bi-sliders2 me-2"></i>Cambiar Prioridad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nueva Prioridad:</label>
                        <select name="nuevaPrioridad" class="form-select">
                            <option value="Alta" selected="@(Model.Prioridad == "Alta")">Alta</option>
                            <option value="Media" selected="@(Model.Prioridad == "Media")">Media</option>
                            <option value="Baja" selected="@(Model.Prioridad == "Baja")">Baja</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Actualizar Prioridad</button>
                </div>
            </form>
        </div>
    </div>
</div>
