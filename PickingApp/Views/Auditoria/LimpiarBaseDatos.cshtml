@{
    ViewData["Title"] = "Limpiar Base de Datos";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 border-start border-danger border-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-danger">
                        <i class="bi bi-radioactive me-2"></i> Limpieza de Base de Datos (CU-15)
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-danger" role="alert">
                        <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-octagon-fill me-1"></i> Advertencia de Función Administrativa y de Pruebas</h6>
                        <p class="small mb-0">
                            Esta función está restringida exclusivamente al Administrador y se mantendrá principalmente para pruebas del proyecto universitario. 
                            <strong>Eliminará todos los pedidos, líneas de productos, novedades, solicitudes y notificaciones</strong>, dejando la base de datos lista para una nueva simulación.
                        </p>
                    </div>

                    <p class="small text-muted">
                        Los usuarios del sistema (Administradores, Supervisores, Auxiliares) y las bodegas y ubicaciones maestras <strong>NO</strong> serán eliminados.
                    </p>

                    <form asp-action="ConfirmarLimpiezaBaseDatos" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-danger">
                                Para confirmar, escriba exactamente <span class="badge bg-danger">LIMPIAR_SISTEMA</span>:
                            </label>
                            <input type="text" name="confirmacion" class="form-control" placeholder="LIMPIAR_SISTEMA" required autocomplete="off" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash3-fill me-1"></i> Ejecutar Limpieza de BD
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>