@model IEnumerable<PickingApp.Models.LogSistema>
@{
    ViewData["Title"] = "LOG del sistema";
}

<h1 class="pf-page-title">LOG del sistema</h1>

<div class="mockup-card">
    <div class="table-responsive">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Accion</th>
                    <th>Descripcion</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var l in Model)
                    {
                        var usuarioDisplay = l.Usuario.Contains("@") ? l.Usuario.Split('@')[0] : l.Usuario;
                        usuarioDisplay = char.ToUpper(usuarioDisplay[0]) + usuarioDisplay.Substring(1);

                        <tr>
                            <td>@l.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@usuarioDisplay</td>
                            <td>@l.Accion</td>
                            <td>@l.Detalle</td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Default mock rows from Slide 28 -->
                    <tr>
                        <td>19/09/2026 16:20</td>
                        <td class="fw-semibold">Juan Perez</td>
                        <td>Asignacion</td>
                        <td>PED-0123 asignado a Carlos Coy</td>
                    </tr>
                    <tr>
                        <td>19/09/2026 15:40</td>
                        <td class="fw-semibold">Juan Perez</td>
                        <td>Carga Excel</td>
                        <td>Archivo pedidos.xlsx cargado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>