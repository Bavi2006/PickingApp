@model PickingApp.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutLogin";
}

<div class="pf-login-card">
    <div class="text-center mb-4">
        <!-- PickFlow Logo matching Slide 1 -->
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-2">
            <!-- Blue rack / shelves -->
            <path d="M22 14L30 10L38 14L30 18L22 14Z" stroke="#00204A" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M22 24L30 20L38 24L30 28L22 24Z" stroke="#00204A" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M22 34L30 30L38 34L30 38L22 34Z" stroke="#00204A" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M22 14V44" stroke="#00204A" stroke-width="2.5" stroke-linecap="round" />
            <path d="M30 18V48" stroke="#00204A" stroke-width="2.5" stroke-linecap="round" />
            <!-- Orange curved picking path arrow -->
            <path d="M34 14H42C46.4183 14 50 17.5817 50 22C50 26.4183 46.4183 30 42 30H38V42" stroke="#EB7D26" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M34 38L38 42L42 38" stroke="#EB7D26" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h2 style="font-weight: 800; font-size: 30px; margin: 0; letter-spacing: -0.5px;">
            <span style="color: #00204A;">Pick</span><span style="color: #EB7D26;">flow</span>
        </h2>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger py-2 text-start small mb-3" role="alert">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 text-start small mb-3" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-2">
            <input asp-for="Correo" class="pf-login-input" placeholder="Usuario" autocomplete="username" />
            <span asp-validation-for="Correo" class="text-danger small d-block text-start mb-2"></span>
        </div>

        <div class="mb-2">
            <input asp-for="Password" class="pf-login-input" placeholder="Contraseña" type="password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small d-block text-start mb-2"></span>
        </div>

        <button type="submit" class="btn-pf-login">
            Iniciar sesión
        </button>

        <div>
            <a asp-action="SolicitarRecuperacion" class="pf-login-link">¿Olvidaste tu contraseña?</a>
        </div>
    </form>

    <div class="mt-4 pt-3 border-top text-center text-muted" style="font-size: 12px;">
        <span class="text-secondary">Pruebas: <code>admin@pickingapp.com</code> / <code>Admin123*</code></span>
    </div>
</div>
