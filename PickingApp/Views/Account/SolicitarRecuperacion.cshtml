@model PickingApp.Models.ViewModels.ForgotPasswordRequestViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutLogin";
}

<div class="pf-login-card">
    <div class="text-center mb-4">
        <h3 class="fw-bold" style="color: #00204A;">Recuperar contraseña</h3>
        <p class="text-muted small">Ingresa tu usuario o correo para solicitar el restablecimiento</p>
    </div>

    @if (ViewBag.MensajeExito != null)
    {
        <div class="alert alert-success small mb-4">
            @ViewBag.MensajeExito
        </div>
        <div>
            <a asp-action="Login" class="btn-pf-login text-decoration-none d-inline-block">
                Volver a iniciar sesión
            </a>
        </div>
    }
    else
    {
        <form asp-action="SolicitarRecuperacion" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3 text-start">
                <input asp-for="Correo" class="pf-login-input" placeholder="Correo electrónico o usuario" required />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="mb-3 text-start">
                <textarea asp-for="Motivo" class="pf-login-input" rows="3" placeholder="Motivo o justificación" style="height: 80px;"></textarea>
                <span asp-validation-for="Motivo" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-pf-login">
                Enviar solicitud
            </button>

            <div class="mt-2">
                <a asp-action="Login" class="pf-login-link">Volver a iniciar sesión</a>
            </div>
        </form>
    }
</div>
