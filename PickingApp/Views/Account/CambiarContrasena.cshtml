@model PickingApp.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<h1 class="pf-page-title">Cambiar contraseña</h1>

<div class="mockup-card" style="max-width: 680px;">
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="mockup-alert-warning mb-4">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="CambiarContrasena" method="post">
        @Html.AntiForgeryToken()

        <div class="mockup-form-group mb-3">
            <label asp-for="CurrentPassword" class="mockup-label">Contraseña actual <span class="text-danger">*</span></label>
            <input asp-for="CurrentPassword" type="password" class="mockup-input" required />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>

        <div class="mockup-form-group mb-3">
            <label asp-for="NewPassword" class="mockup-label">Nueva contraseña <span class="text-danger">*</span></label>
            <input asp-for="NewPassword" type="password" class="mockup-input" required />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="mockup-form-group mb-4">
            <label asp-for="ConfirmPassword" class="mockup-label">Confirmar nueva contraseña <span class="text-danger">*</span></label>
            <input asp-for="ConfirmPassword" type="password" class="mockup-input" required />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-controller="Home" asp-action="Index" class="btn-pf-gray">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Actualizar contraseña
            </button>
        </div>
    </form>
</div>
