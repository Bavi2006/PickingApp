@model IEnumerable<PickingApp.Models.Solicitud>
@{
    ViewData["Title"] = "Solicitudes";
}

<h1 class="pf-page-title">Solicitudes</h1>

<div class="mockup-card mb-4">
    <div class="table-responsive">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tipo</th>
                    <th>Solicitante</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        var tipoDisplay = s.TipoSolicitud switch
                        {
                            "RegistroEmpleado" => "Registro empleado",
                            "EdicionEmpleado" => "Editar empleado",
                            "InactivarEmpleado" => "Inactivar empleado",
                            "CreacionUbicacion" => "Crear ubicación",
                            _ => s.TipoSolicitud
                        };

                        <tr>
                            <td class="fw-semibold">SOL-@s.Id</td>
                            <td>@tipoDisplay</td>
                            <td>@(s.UsuarioSolicitante?.NombreCompleto ?? User.Identity?.Name ?? "Laura Martínez")</td>
                            <td>@s.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                            <td>@s.Estado</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No tienes solicitudes registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-end">
    <a asp-controller="Empleados" asp-action="Crear" class="btn-pf-blue">
        + Crear solicitud
    </a>
</div>
