@model IEnumerable<PickingApp.Models.Solicitud>
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Mis Solicitudes Realizadas</h2>
        <p class="text-muted mb-0">Seguimiento del estado de tus solicitudes enviadas a supervisión y administración</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Tipo</th>
                    <th>Fecha de Solicitud</th>
                    <th>Estado</th>
                    <th>Respuesta</th>
                    <th>Motivo de Rechazo / Observación</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        var badgeEstado = s.Estado switch
                        {
                            "Pendiente" => "bg-warning text-dark",
                            "Aprobada" => "bg-success",
                            "Rechazada" => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="ps-4 fw-bold">#@s.Id</td>
                            <td class="fw-semibold text-primary">@s.TipoSolicitud</td>
                            <td class="small text-muted">@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @badgeEstado rounded-pill">@s.Estado</span></td>
                            <td class="small">
                                @if (s.UsuarioResponde != null)
                                {
                                    <div><strong>@s.UsuarioResponde.NombreCompleto</strong></div>
                                    <div class="text-muted">@s.FechaRespuesta?.ToString("dd/MM/yyyy HH:mm")</div>
                                }
                                else
                                {
                                    <span class="text-muted">En espera de revisión</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.MotivoRechazo))
                                {
                                    <span class="text-danger small">@s.MotivoRechazo</span>
                                }
                                else if (s.Estado == "Aprobada")
                                {
                                    <span class="text-success small"><i class="bi bi-check-circle me-1"></i> Aprobada y ejecutada</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-send-x fs-2 d-block mb-2"></i>
                            Aún no has registrado ninguna solicitud.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
