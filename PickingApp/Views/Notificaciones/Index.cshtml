@model IEnumerable<PickingApp.Models.Notificacion>
@{
    ViewData["Title"] = "Notificaciones";
}

<h1 class="pf-page-title">Notificaciones</h1>

<div class="mockup-card">
    @if (Model != null && Model.Any())
    {
        @foreach (var n in Model)
        {
            <div class="mockup-notification-item">
                <span>@n.Mensaje</span>
                @if (!n.Leida)
                {
                    <form asp-action="MarcarLeida" method="post" class="d-inline ms-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@n.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-dark border-0 py-0 px-2" title="Marcar como leída">
                            ✓
                        </button>
                    </form>
                }
            </div>
        }
    }
    else
    {
        <!-- Mockup items from Slide 20 -->
        <div class="mockup-notification-item">
            Pedido PED-00125 pendiente de asignación.
        </div>
        <div class="mockup-notification-item">
            Hay una solicitud pendiente de revisión.
        </div>
        <div class="mockup-notification-item">
            Carlos Coy tiene un pedido en proceso.
        </div>
    }
</div>