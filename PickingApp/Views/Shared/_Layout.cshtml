<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PickFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
        var userName = User.Identity.Name ?? "Usuario";
        // Get first name or display name
        var displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;
        displayName = char.ToUpper(displayName[0]) + displayName.Substring(1);

        <aside class="pf-sidebar">
            <div>
                <a class="pf-sidebar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-pick">Pick</span><span class="brand-flow">Flow</span>
                </a>

                <ul class="pf-nav">
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            Dashboard
                        </a>
                    </li>
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Pedidos" && currentAction != "CargarExcel" ? "active" : "")" asp-controller="Pedidos" asp-action="Index">
                            Pedidos
                        </a>
                    </li>
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Pedidos" && currentAction == "CargarExcel" ? "active" : "")" asp-controller="Pedidos" asp-action="CargarExcel">
                            Cargar Excel
                        </a>
                    </li>
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Empleados" ? "active" : "")" asp-controller="Empleados" asp-action="Index">
                            Empleados
                        </a>
                    </li>
                    <li class="pf-nav-item">
                        @if (userRole == "Auxiliar")
                        {
                            <a class="pf-nav-link @(currentController == "Solicitudes" ? "active" : "")" asp-controller="Solicitudes" asp-action="MisSolicitudes">
                                Solicitudes
                            </a>
                        }
                        else
                        {
                            <a class="pf-nav-link @(currentController == "Solicitudes" ? "active" : "")" asp-controller="Solicitudes" asp-action="Index">
                                Solicitudes
                            </a>
                        }
                    </li>
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Reportes" ? "active" : "")" asp-controller="Reportes" asp-action="Index">
                            Reportes
                        </a>
                    </li>
                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Notificaciones" ? "active" : "")" asp-controller="Notificaciones" asp-action="Index">
                            Notificaciones
                        </a>
                    </li>

                    @if (userRole == "Administrador")
                    {
                        <li class="pf-nav-item">
                            <a class="pf-nav-link @(currentController == "Usuarios" ? "active" : "")" asp-controller="Usuarios" asp-action="Index">
                                Usuarios y roles
                            </a>
                        </li>
                    }

                    <li class="pf-nav-item">
                        <a class="pf-nav-link @(currentController == "Bodegas" ? "active" : "")" asp-controller="Bodegas" asp-action="Index">
                            Bodegas
                        </a>
                    </li>

                    @if (userRole == "Administrador")
                    {
                        <li class="pf-nav-item">
                            <a class="pf-nav-link @(currentController == "Auditoria" ? "active" : "")" asp-controller="Auditoria" asp-action="Index">
                                Log del sistema
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div class="pf-sidebar-bottom">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-pf-logout">
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </aside>

        <div class="pf-main-wrapper">
            <header class="pf-header">
                <div class="pf-user-badge">
                    <span>@displayName</span> | <span>@userRole</span>
                </div>
            </header>

            <main class="pf-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["WarningMessage"] != null)
                {
                    <div class="mockup-alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container py-5">
            @RenderBody()
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
