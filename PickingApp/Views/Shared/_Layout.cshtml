<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PickingApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PickingApp.styles.css" asp-append-version="true" />
    <style>
        :root {
            --primary-blue: #0d6efd;
            --danger-red: #dc3545;
            --secondary-gray: #6c757d;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .btn-primary {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
            color: #ffffff !important;
        }
        .btn-danger {
            background-color: var(--danger-red);
            border-color: var(--danger-red);
            color: #ffffff !important;
        }
        .btn-outline-secondary {
            background-color: #ffffff;
            border-color: #ced4da;
            color: #495057 !important;
        }
        .btn-outline-secondary:hover {
            background-color: #f8f9fa;
            border-color: #adb5bd;
            color: #212529 !important;
        }
        .nav-link {
            font-weight: 500;
        }
        .role-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.6rem;
            border-radius: 50rem;
        }
    </style>
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center text-white" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam-fill me-2 fs-4"></i> PickingApp
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" 
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
                        var userName = User.Identity.Name ?? "Usuario";

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Pedidos" asp-action="Index">
                                    <i class="bi bi-receipt-cutoff me-1"></i> Pedidos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Empleados" asp-action="Index">
                                    <i class="bi bi-people-fill me-1"></i> Empleados
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Bodegas" asp-action="Index">
                                    <i class="bi bi-building me-1"></i> Bodegas y Ubicaciones
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Reportes" asp-action="Index">
                                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Reportes
                                </a>
                            </li>

                            @if (userRole == "Administrador" || userRole == "Supervisor")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Solicitudes" asp-action="Index">
                                        <i class="bi bi-inbox-fill me-1"></i> Solicitudes
                                    </a>
                                </li>
                            }
                            else if (userRole == "Auxiliar")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Solicitudes" asp-action="MisSolicitudes">
                                        <i class="bi bi-send-check-fill me-1"></i> Mis Solicitudes
                                    </a>
                                </li>
                            }

                            @if (userRole == "Administrador")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill me-1"></i> Administración
                                    </a>
                                    <ul class="dropdown-menu shadow" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-person-gear me-2"></i>Usuarios y Roles</a></li>
                                        <li><a class="dropdown-item" asp-controller="Auditoria" asp-action="Index"><i class="bi bi-journal-text me-2"></i>LOG del Sistema</a></li>
                                        <li><a class="dropdown-item" asp-controller="Auditoria" asp-action="Configuracion"><i class="bi bi-sliders me-2"></i>Configuración del Sistema</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" asp-controller="Auditoria" asp-action="LimpiarBaseDatos"><i class="bi bi-trash3-fill me-2"></i>Limpiar Base de Datos</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center text-white gap-3">
                            <a asp-controller="Notificaciones" asp-action="Index" class="text-white text-decoration-none position-relative" title="Notificaciones">
                                <i class="bi bi-bell-fill fs-5"></i>
                            </a>

                            <div class="dropdown">
                                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 32px; height: 32px;">
                                        @userName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="d-flex flex-column text-start">
                                        <span class="small fw-semibold leading-tight">@userName</span>
                                        <span class="badge bg-light text-primary role-badge mt-1">@userRole</span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="CambiarContrasena"><i class="bi bi-key me-2"></i>Cambiar Contraseña</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="navbar-nav ms-auto">
                            <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-white border-top text-muted">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center small">
            <span>&copy; 2026 - PickingApp | Universidad de Cundinamarca</span>
            <span>Sistema Monolítico de Picking &bull; .NET 8 + MySQL</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
