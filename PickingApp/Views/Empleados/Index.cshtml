@model IEnumerable<PickingApp.Models.Empleado>
@{
    ViewData["Title"] = "Gestión de empleados";
}

<h1 class="pf-page-title">Gestión de empleados</h1>

<div class="mockup-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h4 class="fw-bold mb-0" style="color: #1F2937;">Empleados registrados</h4>
        <a asp-action="Crear" class="btn-pf-blue">
            + Registrar Empleado
        </a>
    </div>

    <div class="table-responsive">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th>Experiencia</th>
                    <th>Turno</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var emp in Model)
                    {
                        var estadoText = emp.EstadoDisponibilidad == "Disponible" ? "Libre" : (emp.EstadoDisponibilidad == "EnPicking" ? "Ocupado" : emp.EstadoDisponibilidad);
                        <tr>
                            <td class="fw-semibold">@emp.NombreCompleto</td>
                            <td>@estadoText</td>
                            <td>@emp.MesesExperiencia meses</td>
                            <td>@(string.IsNullOrEmpty(emp.JornadaLaboral) ? "6:00 – 14:00" : emp.JornadaLaboral)</td>
                            <td class="text-center">
                                <a asp-action="Editar" asp-route-id="@emp.Id" class="btn-pf-blue" style="padding: 4px 20px; font-size: 14px;">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay empleados registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
