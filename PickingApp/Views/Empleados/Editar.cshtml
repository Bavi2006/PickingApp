@model PickingApp.Models.Empleado
@{
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
    ViewData["Title"] = userRole == "Administrador" ? "Editar Empleado" : "Solicitar Edición de Empleado";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-pencil-square me-2"></i> @ViewData["Title"]
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (userRole != "Administrador")
                    {
                        <div class="alert alert-info small mb-4">
                            <i class="bi bi-info-circle-fill me-2"></i> Sus cambios generarán una solicitud formal al Administrador para su aprobación (CU-10).
                        </div>
                    }

                    <form asp-action="Editar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Identificacion" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Identificación</label>
                                <input class="form-control bg-light" value="@Model.Identificacion" disabled />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NombreCompleto" class="form-label fw-semibold">Nombre Completo</label>
                                <input asp-for="NombreCompleto" class="form-control" />
                                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Correo" class="form-label fw-semibold">Correo Electrónico</label>
                                <input asp-for="Correo" class="form-control" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaIngreso" class="form-label fw-semibold">Fecha de Ingreso</label>
                                <input asp-for="FechaIngreso" type="date" class="form-control" />
                                <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="JornadaLaboral" class="form-label fw-semibold">Jornada</label>
                                <select asp-for="JornadaLaboral" class="form-select">
                                    <option value="Diurna">Diurna</option>
                                    <option value="Tarde">Tarde</option>
                                    <option value="Nocturna">Nocturna</option>
                                    <option value="Mixta">Mixta</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="HorarioEntrada" class="form-label fw-semibold">Hora Entrada</label>
                                <input asp-for="HorarioEntrada" type="time" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="HorarioSalida" class="form-label fw-semibold">Hora Salida</label>
                                <input asp-for="HorarioSalida" type="time" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="EstadoDisponibilidad" class="form-label fw-semibold">Disponibilidad Actual</label>
                            <select asp-for="EstadoDisponibilidad" class="form-select">
                                <option value="Disponible">Disponible</option>
                                <option value="EnPicking">En Picking</option>
                                <option value="FueraDeJornada">Fuera de Jornada</option>
                                <option value="Inactivo">Inactivo</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> @(userRole == "Administrador" ? "Guardar Cambios" : "Enviar Solicitud")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
