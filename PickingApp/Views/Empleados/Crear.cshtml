@model PickingApp.Models.Empleado
@{
    ViewData["Title"] = "Registrar empleado";
}

<h1 class="pf-page-title">Registrar empleado</h1>

<div class="mockup-card">
    <div class="mockup-info-banner">
        Complete la información del nuevo empleado. Los campos marcados con * son obligatorios
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="mockup-alert-warning mb-4">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Crear" method="post" id="formEmpleado">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="NombreCompleto" id="hiddenNombreCompleto" />

        <div class="row mb-3">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Nombres <span class="text-danger">*</span></label>
                <input type="text" id="inputNombres" class="mockup-input" placeholder="" required />
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Apellidos <span class="text-danger">*</span></label>
                <input type="text" id="inputApellidos" class="mockup-input" placeholder="" required />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Numero de documento <span class="text-danger">*</span></label>
                <input asp-for="Identificacion" class="mockup-input" placeholder="" required />
                <span asp-validation-for="Identificacion" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Correo electronico <span class="text-danger">*</span></label>
                <input asp-for="Correo" type="email" class="mockup-input" placeholder="" required />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Fecha de ingreso <span class="text-danger">*</span></label>
                <input asp-for="FechaIngreso" type="date" class="mockup-input" required />
                <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Cargo <span class="text-danger">*</span></label>
                <input type="text" name="Cargo" class="mockup-input" value="Auxiliar de Picking" required />
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Turno <span class="text-danger">*</span></label>
                <input asp-for="JornadaLaboral" class="mockup-input" value="6:00 – 14:00" placeholder="6:00 – 14:00" required />
                <span asp-validation-for="JornadaLaboral" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Estado <span class="text-danger">*</span></label>
                <select asp-for="EstadoDisponibilidad" class="mockup-input">
                    <option value="Disponible">Libre (Disponible)</option>
                    <option value="EnPicking">Ocupado</option>
                    <option value="Inactivo">Inactivo</option>
                </select>
                <span asp-validation-for="EstadoDisponibilidad" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-pf-gray">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Registrar empleado
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('formEmpleado').addEventListener('submit', function (e) {
            const nom = document.getElementById('inputNombres').value.trim();
            const ape = document.getElementById('inputApellidos').value.trim();
            document.getElementById('hiddenNombreCompleto').value = (nom + ' ' + ape).trim();
        });
    </script>
}
