@model List<PickingApp.Services.ReporteGeneralTiemposItem>
@{
    ViewData["Title"] = "Reporte General de Tiempos";
    var inicio = (DateTime)ViewBag.FechaInicio;
    var fin = (DateTime)ViewBag.FechaFin;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tiempos Generales</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">Reporte General de Tiempos de Entrega (CU-33)</h2>
            <p class="text-muted mb-0">Periodo: @inicio.ToString("dd/MM/yyyy") - @fin.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="TiemposGenerales" asp-route-fechaInicio="@inicio.ToString("yyyy-MM-dd")" asp-route-fechaFin="@fin.ToString("yyyy-MM-dd")" asp-route-exportarPdf="true" class="btn btn-danger shadow-sm">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Exportar a PDF (CU-36)
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="TiemposGenerales" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Fecha Inicio</label>
                <input type="date" name="fechaInicio" value="@inicio.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Fecha Fin</label>
                <input type="date" name="fechaFin" value="@fin.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Consultar Periodo
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Bodega / Centro Logístico</th>
                    <th class="text-center">Total Pedidos Completados</th>
                    <th class="text-end">Tiempo Promedio</th>
                    <th class="text-end pe-4">Tiempo Total Acumulado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">@item.Bodega</td>
                            <td class="text-center"><span class="badge bg-light text-dark border fs-6">@item.TotalCompletados</span></td>
                            <td class="text-end fw-semibold">@item.PromedioMinutos min</td>
                            <td class="text-end pe-4 text-muted">@item.TiempoTotalMinutos min</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            No se registran pedidos completados por bodegas en el rango consultado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>