@model List<PickingApp.Models.Pedido>
@{
    ViewData["Title"] = "Pedidos Completados, Cancelados y Reasignados";
    var inicio = (DateTime)ViewBag.FechaInicio;
    var fin = (DateTime)ViewBag.FechaFin;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Completados, Cancelados y Reasignados</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">Pedidos Completados, Cancelados y Reasignados (CU-35)</h2>
            <p class="text-muted mb-0">Periodo: @inicio.ToString("dd/MM/yyyy") - @fin.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CompletadosCanceladosReasignados" asp-route-fechaInicio="@inicio.ToString("yyyy-MM-dd")" asp-route-fechaFin="@fin.ToString("yyyy-MM-dd")" asp-route-exportarPdf="true" class="btn btn-danger shadow-sm">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Exportar a PDF (CU-36)
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="CompletadosCanceladosReasignados" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Fecha Inicio</label>
                <input type="date" name="fechaInicio" value="@inicio.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Fecha Fin</label>
                <input type="date" name="fechaFin" value="@fin.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Consultar Periodo
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Código</th>
                    <th>Estado</th>
                    <th>Empleado</th>
                    <th>Fecha Finalización</th>
                    <th>Tiempo Real</th>
                    <th class="pe-4">Motivo / Justificación</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        var badgeEstado = p.Estado switch
                        {
                            "Completado" => "bg-success",
                            "Cancelado" => "bg-danger",
                            "Reasignado" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="ps-4 fw-semibold text-primary">@p.CodigoPedido</td>
                            <td><span class="badge @badgeEstado rounded-pill">@p.Estado</span></td>
                            <td>@(p.Empleado?.NombreCompleto ?? "-")</td>
                            <td class="small text-muted">@(p.FechaFinalizacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>@(p.TiempoProcesamientoMinutos?.ToString("0.0") + " min" ?? "-")</td>
                            <td class="pe-4 small">
                                @if (!string.IsNullOrEmpty(p.MotivoCancelacion))
                                {
                                    <span class="text-danger fw-semibold">Cancelación:</span> @p.MotivoCancelacion
                                }
                                else if (!string.IsNullOrEmpty(p.MotivoReasignacion))
                                {
                                    <span class="text-warning fw-semibold">Reasignación:</span> @p.MotivoReasignacion
                                }
                                else if (p.ConfirmacionFisica)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle me-1"></i> Entrega física confirmada</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            No se registran pedidos completados, cancelados o reasignados en el periodo consultado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>