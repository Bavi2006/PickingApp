@model List<PickingApp.Models.Pedido>
@{
    ViewData["Title"] = "Reporte de Pedidos por Periodo";
    var inicio = (DateTime)ViewBag.FechaInicio;
    var fin = (DateTime)ViewBag.FechaFin;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Pedidos por Periodo</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">Pedidos Cargados por Periodo (CU-34)</h2>
            <p class="text-muted mb-0">Periodo: @inicio.ToString("dd/MM/yyyy") - @fin.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PedidosPorPeriodo" asp-route-fechaInicio="@inicio.ToString("yyyy-MM-dd")" asp-route-fechaFin="@fin.ToString("yyyy-MM-dd")" asp-route-exportarPdf="true" class="btn btn-danger shadow-sm">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Exportar a PDF (CU-36)
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="PedidosPorPeriodo" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Fecha Inicio</label>
                <input type="date" name="fechaInicio" value="@inicio.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Fecha Fin</label>
                <input type="date" name="fechaFin" value="@fin.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Consultar Periodo
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Código</th>
                    <th>Bodega</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Empleado Asignado</th>
                    <th>Fecha Carga</th>
                    <th class="text-end pe-4">Tiempo Real</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        var badgePrioridad = p.Prioridad == "Alta" ? "bg-danger" : (p.Prioridad == "Media" ? "bg-warning text-dark" : "bg-secondary");
                        var badgeEstado = p.Estado switch
                        {
                            "Completado" => "bg-success",
                            "Cancelado" => "bg-danger",
                            "EnProceso" => "bg-primary",
                            "Asignado" => "bg-info text-dark",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="ps-4 fw-semibold text-primary">@p.CodigoPedido</td>
                            <td>@(p.Bodega?.Nombre ?? "N/A")</td>
                            <td><span class="badge @badgePrioridad">@p.Prioridad</span></td>
                            <td><span class="badge @badgeEstado rounded-pill">@p.Estado</span></td>
                            <td>@(p.Empleado?.NombreCompleto ?? "-")</td>
                            <td class="small text-muted">@p.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-4">@(p.TiempoProcesamientoMinutos?.ToString("0.0") + " min" ?? "-")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            No se encontraron pedidos en el rango de fechas seleccionado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>