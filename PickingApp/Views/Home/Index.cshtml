@model IEnumerable<PickingApp.Models.Pedido>
@{
    ViewData["Title"] = "Panel de Control";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Auxiliar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Bienvenido a PickingApp</h2>
        <p class="text-muted mb-0">Panel principal de gestión logística y monitoreo de picking</p>
    </div>
    <div class="d-flex gap-2">
        @if (userRole == "Administrador" || userRole == "Supervisor")
        {
            <a asp-controller="Pedidos" asp-action="CargarExcel" class="btn btn-primary shadow-sm">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Cargar Archivo Excel
            </a>
            <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-person-check-fill me-1"></i> Asignar Pedidos
            </a>
        }
        <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-bar-chart-line-fill me-1"></i> Ver Reportes
        </a>
    </div>
</div>

<!-- Tarjetas de Métricas -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-warning border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pedidos Pendientes</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@ViewBag.TotalPendientes</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-primary border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">En Asignación / Proceso</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@ViewBag.TotalEnProceso</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-success border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Completados Hoy</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@ViewBag.TotalCompletadosHoy</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-check2-all fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-info border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Empleados Disponibles</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@ViewBag.EmpleadosDisponibles</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                        <i class="bi bi-person-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Pedidos Recientes -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="card-title fw-bold mb-0 text-dark">
            <i class="bi bi-clock-history me-2 text-primary"></i> Pedidos Recientes
        </h5>
        <a asp-controller="Pedidos" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            Ver Todos los Pedidos <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Código</th>
                    <th>Bodega</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Empleado Asignado</th>
                    <th>Fecha Carga</th>
                    <th class="text-end pe-4">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var pedido in Model)
                    {
                        var badgePrioridad = pedido.Prioridad == "Alta" ? "bg-danger" : (pedido.Prioridad == "Media" ? "bg-warning text-dark" : "bg-secondary");
                        var badgeEstado = pedido.Estado switch
                        {
                            "Pendiente" => "bg-secondary",
                            "Asignado" => "bg-info text-dark",
                            "EnProceso" => "bg-primary",
                            "Completado" => "bg-success",
                            "Cancelado" => "bg-danger",
                            "Reasignado" => "bg-warning text-dark",
                            _ => "bg-light text-dark"
                        };

                        <tr>
                            <td class="ps-4 fw-semibold text-primary">@pedido.CodigoPedido</td>
                            <td>@(pedido.Bodega?.Nombre ?? "N/A")</td>
                            <td><span class="badge @badgePrioridad">@pedido.Prioridad</span></td>
                            <td><span class="badge @badgeEstado">@pedido.Estado</span></td>
                            <td>@(pedido.Empleado?.NombreCompleto ?? "<span class='text-muted'>Sin asignar</span>")</td>
                            <td class="small text-muted">@pedido.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <a asp-controller="Pedidos" asp-action="Detalle" asp-route-id="@pedido.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i> Detalle
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Aún no se han cargado pedidos en el sistema.
                            @if (userRole == "Administrador" || userRole == "Supervisor")
                            {
                                <div class="mt-2">
                                    <a asp-controller="Pedidos" asp-action="CargarExcel" class="btn btn-sm btn-primary">
                                        Cargar primer archivo Excel
                                    </a>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
