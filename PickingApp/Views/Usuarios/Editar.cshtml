@model PickingApp.Models.Usuario
@{
    ViewData["Title"] = "Editar usuario";
    var username = Model.Correo.Contains("@") ? Model.Correo.Split('@')[0] : Model.Correo;
}

<h1 class="pf-page-title">Editar usuario</h1>

<div class="mockup-card">
    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="row mb-3">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Nombre de usuario <span class="text-danger">*</span></label>
                <input type="text" class="mockup-input" value="@username" disabled style="background-color: #E5E7EB !important;" />
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Correo electrónico <span class="text-danger">*</span></label>
                <input type="text" class="mockup-input" value="@Model.Correo" disabled style="background-color: #E5E7EB !important;" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Nombre completo <span class="text-danger">*</span></label>
                <input type="text" name="nombreCompleto" class="mockup-input" value="@Model.NombreCompleto" required />
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Rol <span class="text-danger">*</span></label>
                <select name="rol" class="mockup-input" required>
                    <option value="Administrador" selected="@(Model.Rol == "Administrador")">Administrador</option>
                    <option value="Supervisor" selected="@(Model.Rol == "Supervisor")">Supervisor</option>
                    <option value="Auxiliar" selected="@(Model.Rol == "Auxiliar")">Auxiliar</option>
                </select>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Estado <span class="text-danger">*</span></label>
                <select name="estado" class="mockup-input" required>
                    <option value="Activo" selected="@(Model.Estado == "Activo")">Activo</option>
                    <option value="Inactivo" selected="@(Model.Estado == "Inactivo")">Inactivo</option>
                    <option value="Bloqueado" selected="@(Model.Estado == "Bloqueado")">Bloqueado</option>
                </select>
            </div>
        </div>

        <div class="mockup-alert-warning mb-4" style="font-weight: normal;">
            Cambiar el rol modificara los módulos y permisos disponibles para este usuario.
        </div>

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn-pf-gray">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Guardar cambios
            </button>
        </div>
    </form>
</div>