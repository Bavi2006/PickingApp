@model IEnumerable<PickingApp.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios y Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Usuarios y Roles del Sistema</h2>
        <p class="text-muted mb-0">Administración de cuentas, roles de acceso y desbloqueo de usuarios (CU-04, CU-05)</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Nombre Completo</th>
                    <th>Correo Electrónico</th>
                    <th>Rol Asignado</th>
                    <th>Estado</th>
                    <th>Intentos Fallidos</th>
                    <th>Último Acceso</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var badgeRol = u.Rol switch
                    {
                        "Administrador" => "bg-danger",
                        "Supervisor" => "bg-primary",
                        "Auxiliar" => "bg-info text-dark",
                        _ => "bg-secondary"
                    };

                    var badgeEstado = u.Estado switch
                    {
                        "Activo" => "bg-success",
                        "Bloqueado" => "bg-danger",
                        "Inactivo" => "bg-secondary",
                        _ => "bg-light text-dark"
                    };

                    <tr>
                        <td class="ps-4 fw-bold text-dark">@u.NombreCompleto</td>
                        <td>@u.Correo</td>
                        <td><span class="badge @badgeRol">@u.Rol</span></td>
                        <td><span class="badge @badgeEstado rounded-pill">@u.Estado</span></td>
                        <td>
                            @if (u.IntentosFallidos > 0)
                            {
                                <span class="badge bg-warning text-dark">@u.IntentosFallidos / 5</span>
                            }
                            else
                            {
                                <span class="text-muted small">0</span>
                            }
                        </td>
                        <td class="small text-muted">@(u.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "Sin registros")</td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Editar" asp-route-id="@u.Id" class="btn btn-outline-secondary" title="Editar Rol / Credenciales">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                @if (u.Estado == "Bloqueado")
                                {
                                    <form asp-action="Desbloquear" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-success" title="Desbloquear Cuenta">
                                            <i class="bi bi-unlock-fill"></i> Desbloquear
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>