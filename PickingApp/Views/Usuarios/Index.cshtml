@model IEnumerable<PickingApp.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios y roles";
}

<h1 class="pf-page-title">Usuarios y roles</h1>

<div class="mockup-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h4 class="fw-bold mb-0" style="color: #1F2937;">Usuarios registrados</h4>
        <a asp-action="Crear" class="btn-pf-blue">
            + Nuevo usuario
        </a>
    </div>

    <div class="table-responsive">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Nombre</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var u in Model)
                    {
                        var usuarioAlias = u.Correo.Contains("@") ? u.Correo.Split('@')[0] : u.Correo;

                        <tr>
                            <td class="fw-semibold">@usuarioAlias</td>
                            <td>@u.NombreCompleto</td>
                            <td>@u.Rol</td>
                            <td>@u.Estado</td>
                            <td class="text-center">
                                <a asp-action="Editar" asp-route-id="@u.Id" class="btn-pf-blue" style="padding: 4px 20px; font-size: 14px;">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay usuarios registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>