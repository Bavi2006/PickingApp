@model PickingApp.Models.Usuario
@{
    ViewData["Title"] = "Crear Nuevo Usuario";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-person-plus-fill me-2"></i> Crear Usuario en el Sistema
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label fw-semibold">Nombre Completo</label>
                            <input asp-for="NombreCompleto" class="form-control" placeholder="Ej: Santiago Parra" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label fw-semibold">Correo Electrónico</label>
                            <input asp-for="Correo" class="form-control" placeholder="usuario@pickingapp.com" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Contraseña Inicial</label>
                            <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                            <div class="form-text small">Mínimo 6 caracteres con letras y números.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Rol" class="form-label fw-semibold">Rol del Usuario (CU-05)</label>
                            <select asp-for="Rol" class="form-select">
                                <option value="Auxiliar">Auxiliar (Solo consulta y solicitudes)</option>
                                <option value="Supervisor">Supervisor (Carga Excel, asigna pedidos y gestiona)</option>
                                <option value="Administrador">Administrador (Acceso total, seguridad y auditoría)</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Registrar Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>