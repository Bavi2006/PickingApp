@model PickingApp.Models.Bodega
@{
    ViewData["Title"] = "Crear Nueva Bodega";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-building-add me-2"></i> Crear Nueva Bodega
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Codigo" class="form-label fw-semibold">Código de Bodega</label>
                            <input asp-for="Codigo" class="form-control text-uppercase" placeholder="Ej: BOD-01" />
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Bodega</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Bodega Principal Centro" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-semibold">Descripción (Opcional)</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalles de capacidad o tipo de mercancía"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i> Guardar Bodega
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
