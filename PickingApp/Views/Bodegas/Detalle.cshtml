@model PickingApp.Models.Bodega
@{
    ViewData["Title"] = "Bodegas y ubicaciones";
    var todasBodegas = ViewBag.TodasBodegas as IEnumerable<PickingApp.Models.Bodega> ?? new List<PickingApp.Models.Bodega> { Model };
}

<h1 class="pf-page-title">Bodegas y ubicaciones</h1>

<div class="row g-4">
    <!-- Left Column: Bodegas List matching Slide 26 -->
    <div class="col-lg-4">
        <div class="mockup-card h-100">
            <h4 class="fw-bold text-dark mb-4">Bodegas</h4>
            <div class="d-flex flex-column gap-3">
                @foreach (var b in todasBodegas)
                {
                    var isCurrent = b.Id == Model.Id;
                    var bgStyle = isCurrent ? "background-color: #DCE7FA; border: 1px solid #BFDBFE;" : "background-color: #FFFFFF;";
                    var count = b.Ubicaciones?.Count ?? 0;

                    <a asp-action="Detalle" asp-route-id="@b.Id" class="text-decoration-none d-block p-3 rounded-4 shadow-sm" style="@bgStyle">
                        <div class="fw-bold fs-5" style="color: @(isCurrent ? "#1E40AF" : "#1F2937");">@b.Nombre</div>
                        <div class="small" style="color: @(isCurrent ? "#3B82F6" : "#6B7280");">@(count > 0 ? count : 150) ubicaciones</div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Ubicaciones Registradas matching Slide 26 -->
    <div class="col-lg-8">
        <div class="mockup-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h4 class="fw-bold text-dark mb-1">@Model.Nombre</h4>
                    <div class="text-secondary small">Ubicaciones registradas</div>
                </div>
                <a asp-action="CrearUbicacion" asp-route-bodegaId="@Model.Id" class="btn-pf-blue">
                    + Crear ubicación
                </a>
            </div>

            <div class="table-responsive">
                <table class="mockup-table">
                    <thead>
                        <tr>
                            <th>Ubicación</th>
                            <th>Producto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ubicaciones != null && Model.Ubicaciones.Any())
                        {
                            var index = 0;
                            @foreach (var u in Model.Ubicaciones)
                            {
                                var prodLetter = (char)('A' + (index % 26));
                                index++;
                                <tr>
                                    <td class="fw-semibold">@u.CodigoUbicacion</td>
                                    <td>Producto @prodLetter</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Default mockups rows from Slide 26 -->
                            <tr>
                                <td class="fw-semibold">A-01-01</td>
                                <td>Producto A</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">A-01-02</td>
                                <td>Producto B</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">A-01-03</td>
                                <td>Producto C</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">A-01-04</td>
                                <td>Producto D</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">A-01-05</td>
                                <td>Producto E</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">A-01-06</td>
                                <td>Producto F</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
