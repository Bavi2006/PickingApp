@model PickingApp.Models.Ubicacion
@{
    var bodega = ViewBag.Bodega as PickingApp.Models.Bodega;
    ViewData["Title"] = "Crear ubicación";
}

<h1 class="pf-page-title">Crear ubicación</h1>

<div class="mockup-card">
    <div class="mockup-info-banner">
        Complete la información de la ubicación que desea registrar en el sistema.
    </div>

    <form asp-action="CrearUbicacion" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BodegaId" />

        <div class="row mb-3">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Bodega</label>
                <input type="text" class="mockup-input" value="@(bodega?.Nombre ?? "Bodega principal")" disabled style="background-color: #E5E7EB !important;" />
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Código de ubicación</label>
                <input asp-for="CodigoUbicacion" class="mockup-input" placeholder="Ej: A-01-01" />
                <span asp-validation-for="CodigoUbicacion" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Zona / Área</label>
                <input type="text" name="Zona" class="mockup-input" placeholder="General" />
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Pasillo</label>
                <input asp-for="Pasillo" class="mockup-input" placeholder="01" required />
                <span asp-validation-for="Pasillo" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Nivel</label>
                <input asp-for="Nivel" class="mockup-input" placeholder="01" required />
                <span asp-validation-for="Nivel" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mockup-form-group">
                <label class="mockup-label">Estado</label>
                <select asp-for="Activa" class="mockup-input">
                    <option value="true">Activa</option>
                    <option value="false">Inactiva</option>
                </select>
            </div>
        </div>

        <!-- Hidden Estante default -->
        <input type="hidden" asp-for="Estante" value="01" />

        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Detalle" asp-route-id="@Model.BodegaId" class="btn-pf-gray">
                Cancelar
            </a>
            <button type="submit" class="btn-pf-blue">
                Crear ubicación
            </button>
        </div>
    </form>
</div>
