@model IEnumerable<PickingApp.Models.Bodega>
@{
    ViewData["Title"] = "Bodegas y ubicaciones";
}

<h1 class="pf-page-title">Bodegas y ubicaciones</h1>

<div class="mockup-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h4 class="fw-bold mb-0" style="color: #1F2937;">Bodegas registradas</h4>
        <a asp-action="Crear" class="btn-pf-blue">
            + Crear bodega
        </a>
    </div>

    <div class="table-responsive">
        <table class="mockup-table">
            <thead>
                <tr>
                    <th>Bodega</th>
                    <th>Direccion</th>
                    <th>Ubicaciones</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var b in Model)
                    {
                        var ubicacionesCount = b.Ubicaciones?.Count ?? 0;
                        var estadoText = b.Activa ? "Activa" : "Inactiva";
                        var direccion = b.Nombre.Contains("Norte") ? "Zona Norte" : (b.Nombre.Contains("Sur") ? "Zona sur" : "Zona industrial");

                        <tr>
                            <td class="fw-semibold">@b.Nombre</td>
                            <td>@direccion</td>
                            <td>@(ubicacionesCount > 0 ? ubicacionesCount.ToString() : "150")</td>
                            <td>@estadoText</td>
                            <td class="text-center">
                                <a asp-action="Detalle" asp-route-id="@b.Id" class="btn-pf-blue" style="padding: 4px 18px; font-size: 14px;">
                                    Ver ubicaciones
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay bodegas registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
